[user]
    name = Gian Violi
    email = 96206151+gfvioli@users.noreply.github.com
[pull]
	rebase = true

[init]
    defaultBranch = main

[core]
    pager = delta
    excludesFile = /home/gfvioli/.gitignore

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true # use n and N to move between diff sections
    side-by-side = true

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
	count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
	count-lines-prod = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '/^[^[:space:]]/ && !/\\.ipynb$/ { add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[rerere]
	enabled = true
